# Backend real (AWS Lambda + DynamoDB). No se usa en modo demo.
VITE_API_BASE=https://<api-gateway-id>.execute-api.<region>.amazonaws.com/api

# true = usa datos y reflexiones pregrabadas (sin backend, sin coste de IA).
# Esto es lo que se despliega en GitHub Pages como demo pública.
VITE_DEMO_MODE=false
