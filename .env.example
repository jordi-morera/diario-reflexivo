# Backend - Desarrollo local
ANTHROPIC_API_KEY=sk-ant-...
FLASK_ENV=development
FLASK_DEBUG=True

# DynamoDB (solo necesario si usas DynamoDB Local)
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000

# AWS (solo necesario para desarrollo local con AWS)
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# Producción (en AWS Lambda, configura estas variables en la consola/CLI)
# ENTRIES_TABLE=DiaryEntries
# REFLECTIONS_TABLE=Reflections
# ANTHROPIC_SECRET_NAME=diario-reflexivo/anthropic-api-key
# FRONTEND_ORIGIN=https://tu-dominio.cloudfront.net

# Frontend - Vite
# VITE_API_BASE=https://tu-api-gateway.execute-api.region.amazonaws.com/api